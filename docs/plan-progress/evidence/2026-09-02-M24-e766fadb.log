##[T24.4]
--- gate compose env ---
# Image version pins. Single source of truth: docker-compose.yml AND
# scripts/gates/m24.sh read PROMETHEUS_VERSION from this file. Never add a
# second copy of the version, and never fall back to :latest — the gate
# validates rules with exactly the Prometheus that loads them.
PROMETHEUS_VERSION=v3.13.1
JAEGER_VERSION=1.70.0
RESTITCH_IMAGE_TAG=dev

# Host port bindings. Prometheus is on 9091, NOT its conventional 9090,
# because the gateway admin/metrics server already owns 9090.
GATEWAY_PORT=8080
GATEWAY_ADMIN_PORT=9090
STUDIO_PORT=3080
PROMETHEUS_PORT=9091
JAEGER_UI_PORT=16686

# Set to a non-empty value to require X-Admin-Key on the gateway admin API.
# The key is REQUIRED since hardening C3: with an empty value every admin
# request is rejected. /metrics and /health stay unauthenticated either way,
# so Prometheus does not need this secret.
RESTITCH_ADMIN_API_KEY=restitch-dev

# Shared registry key between the gateway poller and the Studio registry API.
# The gateway sends it as X-Admin-Key; the Studio verifies it. Both sides
# read this same variable, so change it in one place. Override in .env.
RESTITCH_REGISTRY_KEY=restitch-dev

# Tracing. Unset disables the exporter entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
GATEWAY_PORT=58134
GATEWAY_ADMIN_PORT=58135
STUDIO_PORT=58136
PROMETHEUS_PORT=58137
JAEGER_UI_PORT=58138
