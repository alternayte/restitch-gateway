# Copy to deploy/.env and fill in the empty values. Never commit deploy/.env.

# Image version pins. docker-compose.yml and scripts/gates/m24.sh read
# PROMETHEUS_VERSION from this file. Never fall back to :latest.
PROMETHEUS_VERSION=v3.13.1
POSTGRES_VERSION=17-alpine
RESTITCH_IMAGE_TAG=dev

# Host ports.
STUDIO_PORT=3080
GATEWAY_1_PORT=8080
GATEWAY_2_PORT=8082
PROMETHEUS_PORT=9091

# The URL people use to reach Studio. Sign-in cookies are bound to it.
STUDIO_PUBLIC_URL=http://localhost:3080

# Required. Use URL-safe characters: the password is part of the
# RESTITCH_DATABASE_URL that Studio receives.
POSTGRES_PASSWORD=

# Required. The first owner, created when the database holds no user.
RESTITCH_BOOTSTRAP_EMAIL=
RESTITCH_BOOTSTRAP_PASSWORD=

# Step two of the bring-up: a gateway token (rgt_...) created on the Gateway
# tokens page of the environment that the gateways serve.
RESTITCH_GATEWAY_TOKEN=
